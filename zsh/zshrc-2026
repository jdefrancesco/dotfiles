
# =============================================================================
# Environment
# =============================================================================

export ZSH="$HOME/.oh-my-zsh"

export LANG="en_US.UTF-8"
export EDITOR="nvim"

DISABLE_AUTO_TITLE="true"
ENABLE_CORRECTION="true"

# Java 21
export JAVA_HOME=$(/usr/libexec/java_home -v 21)


# =============================================================================
# PATH
# =============================================================================

# Prevent duplicate PATH entries
typeset -U path PATH

path=(
  "$JAVA_HOME/bin"
  "$HOME/.local/bin"
  "/opt/homebrew/bin"
  "$HOME/go/bin"
  /usr/local/bin
  /usr/bin
  /bin
  /usr/sbin
  /sbin
  $path
)

export PATH

# Man pages
export MANPATH="/usr/local/man:${MANPATH:-}"

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"


# =============================================================================
# Completion Configuration
# =============================================================================

# Add Homebrew completions BEFORE Oh My Zsh initializes compinit.
if [[ -d /opt/homebrew/share/zsh/site-functions ]]; then
  fpath=(
    /opt/homebrew/share/zsh/site-functions
    $fpath
  )
fi

# Prevent duplicate function search directories
typeset -U fpath

# Completion styling
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*' verbose yes
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# NOTE:
# Do not call compinit here.
# Oh My Zsh initializes the completion system automatically.


# =============================================================================
# History
# =============================================================================

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY


# =============================================================================
# Shell Options
# =============================================================================

setopt EXTENDED_GLOB
setopt AUTO_CD
setopt INTERACTIVE_COMMENTS


# =============================================================================
# Oh My Zsh
# =============================================================================

ZSH_THEME="infinite"

plugins=(
  git
  fzf
  z
  catimg
  taskwarrior
)

source "$ZSH/oh-my-zsh.sh"


# =============================================================================
# Aliases
# =============================================================================

# Editors
alias vim='nvim'
alias zed='nvim ~/.zshrc'
alias zr='exec zsh'
alias ohmyzsh='nvim ~/.oh-my-zsh'

# Utilities
alias cheat='cheat -c'

# Better CLI defaults
alias ls='eza'
alias ll='eza -lah --git'
alias la='eza -a'
alias lt='eza --tree --level=2'

alias cat='bat --paging=never'
alias grep='grep --color=auto'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'


# =============================================================================
# Base16 Shell
# =============================================================================

BASE16_SHELL="$HOME/.config/base16-shell/"

if [[ -o interactive && -s "$BASE16_SHELL/profile_helper.sh" ]]; then
  source "$BASE16_SHELL/profile_helper.sh"
fi

# Apply theme if available
if (( $+functions[base16_atelier-dune] )); then
  base16_atelier-dune
fi

